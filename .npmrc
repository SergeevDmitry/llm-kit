# Keep the dependency graph honest: no implicit access to transitive packages.
strict-peer-dependencies=false
auto-install-peers=true
# Publish with npm provenance: every tarball is cryptographically tied to the
# commit and workflow run that built it, which is the defence against a
# compromised action publishing under our name. This used to read
# `provenance=false` while release.yml set NPM_CONFIG_PROVENANCE=true — a
# contradiction whose outcome depended on undocumented precedence between
# npm's env layer and pnpm's .npmrc reader. Both now say the same thing.
#
# Provenance requires a CI runner with an OIDC identity; a local `npm publish`
# without one will fail rather than silently publish unattested. That is the
# intended behaviour: releases come from the workflow.
provenance=true
